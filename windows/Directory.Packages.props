<Project>
  <!--
    Central package versions.

    Windows App SDK: instead of the Microsoft.WindowsAppSDK metapackage (2.5.1), only the
    component packages the WinUI shell needs are referenced, so AI / ML / Search / Widgets /
    DWriteCore binaries are not shipped. The versions below are exactly the ones the
    Microsoft.WindowsAppSDK 2.5.1 metapackage pins; bump them together when updating:
    https://www.nuget.org/packages/Microsoft.WindowsAppSDK
      - WinUI                  2.3.9  (depends on Base, Foundation, InteractiveExperiences, WebView2)
      - Foundation             2.3.12 (Bootstrap, MRT Core, self-contained runtime DLLs)
      - InteractiveExperiences 2.1.9  (required by WinUI and Foundation; Composition/Input)
    Microsoft.WindowsAppSDK.Runtime is not needed: it only adds the framework-package (MSIX)
    reference used by framework-dependent apps, and this app is WindowsAppSDKSelfContained.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
