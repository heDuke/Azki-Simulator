<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Azki.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Padding="36,24" Spacing="12">
      <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />
      <TextBlock Text="M0 骨架：应用设置将在 M4 中实现。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <TextBlock x:Name="EnvironmentText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Page>
