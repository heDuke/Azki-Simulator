<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Azki.App.Views.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
  <Grid Padding="24,16" ColumnSpacing="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="360" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Controls: firmware, device model, start/stop, status. -->
    <ScrollViewer Grid.Column="0">
      <StackPanel Spacing="12">
        <TextBlock Text="工作区" Style="{StaticResource TitleTextBlockStyle}" />

        <InfoBar
            Severity="Error"
            IsClosable="False"
            Title="引擎缺失"
            Message="{x:Bind ViewModel.EngineMissingMessage}"
            IsOpen="{x:Bind ViewModel.EngineMissing}" />

        <TextBlock Text="固件包（OTA zip）" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox
              x:Name="FirmwareBox"
              PlaceholderText="选择或粘贴固件路径"
              Text="{x:Bind ViewModel.FirmwarePath, Mode=OneWay}"
              IsEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}"
              KeyDown="OnFirmwareKeyDown" />
          <Button Grid.Column="1" Content="浏览…" Click="OnBrowse" IsEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}" />
        </Grid>

        <TextBlock Text="设备型号" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <ComboBox
            x:Name="ModelBox"
            HorizontalAlignment="Stretch"
            PlaceholderText="导入固件后选择"
            ItemsSource="{x:Bind ViewModel.Candidates}"
            DisplayMemberPath="DisplayName"
            IsEnabled="{x:Bind ViewModel.CanSelectModel, Mode=OneWay}"
            SelectionChanged="OnModelChanged" />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Style="{StaticResource AccentButtonStyle}" Click="OnStart" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <SymbolIcon Symbol="Play" />
              <TextBlock Text="启动" />
            </StackPanel>
          </Button>
          <Button Click="OnStop" IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <SymbolIcon Symbol="Stop" />
              <TextBlock Text="停止" />
            </StackPanel>
          </Button>
          <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" />
        </StackPanel>

        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

        <InfoBar
            Severity="Error"
            IsClosable="False"
            Title="出错了"
            Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" />

        <TextBlock
            Text="{x:Bind ViewModel.EngineText}"
            TextWrapping="Wrap"
            IsTextSelectionEnabled="True"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </ScrollViewer>

    <!-- Live device screen: WriteableBitmap, aspect kept by Stretch=Uniform. -->
    <Border
        Grid.Column="1"
        Background="Black"
        CornerRadius="12"
        Padding="8">
      <Grid>
        <TextBlock
            Text="设备画面"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        <Image
            x:Name="Screen"
            Stretch="Uniform"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            PointerPressed="OnScreenPointerPressed"
            PointerMoved="OnScreenPointerMoved"
            PointerReleased="OnScreenPointerReleased"
            PointerCanceled="OnScreenPointerReleased" />
      </Grid>
    </Border>
  </Grid>
</Page>
